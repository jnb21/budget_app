# Copy this file to .env and fill in the values: cp .env.example .env
# .env is ignored by git; this example file is committed so others know what to set.

# Postgres (used by docker-compose.yml to create the database)
POSTGRES_USER=budget
POSTGRES_DB=budget
POSTGRES_PASSWORD=change-me

# Backend: how the app connects to that database (port 5433, see docker-compose.yml)
DATABASE_URL=postgresql://budget:change-me@localhost:5433/budget
