# Copy this file to .env and fill in the values: cp .env.example .env
# .env is ignored by git; this example file is committed so others know what to set.

# Postgres (used by docker-compose.yml to create the database)
POSTGRES_USER=budget
POSTGRES_DB=budget
POSTGRES_PASSWORD=change-me

# Backend: two logins to that database (port 5433, see docker-compose.yml).
# Why two: README, "Two database logins".
# The owner (the POSTGRES_* user above): creates tables and rules. Migrations only;
# in production, give it to the migration step and not to the running app.
MIGRATION_DATABASE_URL=postgresql://budget:change-me@localhost:5433/budget
# The app's login: reads and writes rows only, so row-level security applies to it.
# Migrations create it with this password; use a different one from the owner's.
DATABASE_URL=postgresql://budget_app:change-me-too@localhost:5433/budget

# Login sessions
SESSION_DAYS=30
# true in production (HTTPS): the session cookie is then only sent over HTTPS
COOKIE_SECURE=false
